---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SourcesSection from '../../components/SourcesSection.astro';
import { faqEn } from '../../data/faq';
import { buildAttractionSchema, buildBreadcrumbSchema, buildFaqSchema } from '../../lib/schema';
import { govtTourismUrl, nearbyLandmarks, photos, siteMeta } from '../../data/site';
import WeatherSection from '../../components/WeatherSection.astro';
import {
  quarterly,
  climateNature,
  groupPlans,
  routes,
  visitorServices,
  responsibility,
  type Bi,
} from '../../data/guide';

const en = true;
const bi = (b: Bi) => (en ? b.en : b.ur);
const t = {
  qEyebrow: { ur: 'ربع سالانہ حکمتِ عملی', en: 'Quarterly strategy' },
  qTitle: { ur: 'سال بھر میں بہترین وقت', en: 'The best time through the year' },
  qLead: { ur: 'اسلام آباد کے موسمی چکر کے مطابق فیصل مسجد دیکھنے کا منصوبہ بنائیں۔', en: 'Plan your Faisal Mosque visit around Islamabad’s seasonal cycle.' },
  qClimate: { ur: 'موسم', en: 'Climate' },
  qAdvice: { ur: 'مشورہ', en: 'Advice' },
  qBest: { ur: 'موزوں برائے', en: 'Best for' },
  cEyebrow: { ur: 'موسم، فضا اور قدرت', en: 'Climate, air & nature' },
  cTitle: { ur: 'موسم، فضائی معیار اور قدرتی ماحول کا تجزیہ', en: 'Climate, air quality & natural environment' },
  cLead: { ur: 'طویل المدت ریکارڈ کی بنیاد پر ایک متوازن تجزیہ۔', en: 'A balanced reading based on long-term records.' },
  pEyebrow: { ur: 'آپ کا سفری گروپ', en: 'Your travel group' },
  pTitle: { ur: 'سفری تشکیل کے مطابق تجاویز', en: 'Tips by travel composition' },
  pLead: { ur: 'اپنی سفری ترکیب اور رفتار کے مطابق راستہ چنیں۔', en: 'Choose a route by your group and pace.' },
  rEyebrow: { ur: 'تجویز کردہ راستے', en: 'Suggested routes' },
  rTitle: { ur: 'عمومی راستے: نصفِ دن اور پورا دن', en: 'General routes: half-day & full-day' },
  rLead: { ur: 'وقت کے مطابق دو متبادل راستے۔', en: 'Two alternatives by available time.' },
  sEyebrow: { ur: 'زائرین کی سہولیات', en: 'Visitor services' },
  sTitle: { ur: 'آس پاس کی سہولیات (قسم کے لحاظ سے)', en: 'Facilities nearby (by type)' },
  sLead: { ur: 'مخصوص کاروبار کی سفارش نہیں، صرف اقسام کی رہنمائی۔', en: 'No specific business recommended — only guidance by type.' },
  resEyebrow: { ur: 'سائنسی پہلو اور ذمہ داری', en: 'Science & responsibility' },
  resTitle: { ur: 'زائرین کی ذمہ داری اور مقام کی حفاظت', en: 'Visitor responsibility & site care' },
  resLead: { ur: 'ایک پر امن مقام کو برقرار رکھنے میں آپ کا کردار۔', en: 'Your role in keeping a peaceful site intact.' },
};

const pageUrl = Astro.site ? new URL('/en/', Astro.site).href : undefined;
const attractionJsonLd = buildAttractionSchema(pageUrl);
const breadcrumbJsonLd = buildBreadcrumbSchema(pageUrl, [
  { name: siteMeta.countryLatin, url: pageUrl },
  { name: siteMeta.regionLatin },
  { name: siteMeta.cityLatin },
  { name: `${siteMeta.englishName} (${siteMeta.latinName})` },
]);
const faqItems = faqEn;
const faqJsonLd = buildFaqSchema(faqItems);

const history = [
  ['1969', 'International design competition', 'The competition organised with the Capital Development Authority and Pakistani architectural circles drew 43 entries from 17 countries. The concept by Turkish architect Vedat Dalokay was selected.'],
  ['1970s', 'A concept away from the traditional dome', 'Instead of copying a historic South Asian mosque, the winning scheme was built around a large triangular concrete shell resembling a Bedouin tent, proposing a new visual language for modern Islamabad.'],
  ['1976', 'Construction begins', 'Construction started in the mid-1970s. The mosque was named after King Faisal of Saudi Arabia; Saudi support was significant, while Pakistani government and CDA records also document the local institutional role in construction and upkeep.'],
  ['1986', 'Building completed', 'After roughly a decade of work the main complex was completed. In the following years it became the national mosque, a working place of worship and one of the most recognisable modern buildings in Islamabad.'],
];

const architecture = [
  ['A tent instead of a dome', 'The main prayer hall is covered by a vast tent-like roof rather than a traditional dome, which is why the silhouette reads as a single white mass from a distance.'],
  ['Four slim minarets', 'Four slender minarets frame the shell and give the composition its vertical rhythm against the Margalla Hills backdrop.'],
  ['Geometry, light and landscape', 'White surfaces, strong geometry and the open courtyard are designed to be read together with the hills behind them, especially in late afternoon light.'],
  ['Calligraphy and quiet interior', 'The interior is treated with restraint — calligraphy, filtered light and a large open volume — so the building works first as a place of prayer.'],
];

const visitCards = [
  ['Visiting hours', 'Faisal Mosque is a working mosque, so it follows the daily prayer schedule rather than fixed ticketed hours. Respectful visits are generally possible in daylight hours; Friday midday prayers, Ramadan and Eid change access.'],
  ['Entry and tickets', 'Entry is generally free and no tourist ticket is required. During prayers or special security arrangements, some sections can be closed to visitors.'],
  ['Dress code', 'Wear modest clothing that covers shoulders and legs. Women are advised — and sometimes required — to cover their heads. Shoes are removed before entering the prayer hall.'],
  ['Etiquette on site', 'Keep voices low, avoid walking in front of worshippers during prayer, and do not eat inside the prayer hall. Follow staff and security instructions first.'],
  ['How long to allow', 'Around 60 to 90 minutes covers the architecture, courtyards, interior and photography. Allow extra time on Fridays.'],
  ['Best time of day', 'Weekday mornings or the period before Asr are calmer. Sunset light on the white shell and the Margalla Hills is the most photogenic moment.'],
];

const transport = [
  ['From Islamabad International Airport', 'The airport sits to the south-west of the city; by road the transfer usually takes well under an hour in normal traffic, but Friday noon, prayer peaks and weather can add time.'],
  ['Metro bus and feeder route FR-03A', 'The published CDA feeder route FR-03A links PIMS Hospital / Metro Station with Faisal Mosque. Routes and frequency change, so check the official Capital Mass Transit information or app before departure.'],
  ['Taxi and ride-hailing', 'Taxis and ride-hailing services are widely used in Islamabad and drop visitors at the main approach on Shah Faisal Avenue; agree the fare or use the in-app estimate before starting.'],
  ['Private car and parking', 'Driving is straightforward on Islamabad’s planned grid, and parking is available near the complex, though capacity drops sharply at Friday prayers.'],
];

const nearby = [
  ['Margalla Hills National Park', 'The hill range directly behind the mosque; trails and natural viewpoints combine well with the mosque in a single half-day.'],
  ['Daman-e-Koh', 'A well-known viewpoint over the city; allow extra time for traffic and weather conditions.'],
  ['Saidpur Village', 'A historic settlement at the foot of the Margalla Hills that shows an older layer of the region alongside the modern capital.'],
  ['Pakistan Monument & Museum', 'National history and symbolic architecture, useful as a comparative read on Pakistan’s modern national identity.'],
  ['Lok Virsa', 'A cultural institution focused on Pakistan’s regional heritage, crafts and living traditions.'],
  ['Around Rawal Lake', 'Open landscape and recreation in the south-east of the city; treat it as a separate half-day if time is short.'],
];
---
export const prerender = false;

<BaseLayout
  lang="en"
  alternatePath="/"
  title="Faisal Mosque Islamabad — Timings, History, Architecture & Visitor Guide"
  description="Independent visitor guide to Faisal Mosque (Faisal Masjid) in Islamabad, Pakistan: visiting hours and prayer times, free entry, dress code, Metro bus route FR-03A, parking, Margalla Hills location and map, history and architecture."
  ogImage={photos.hero.src}
  ogImageAlt="Faisal Mosque (Faisal Masjid) in Islamabad — white tent-like main hall and four minarets in front of the Margalla Hills"
  jsonLd={[attractionJsonLd, faqJsonLd, breadcrumbJsonLd].filter(Boolean)}
>
  <section class="hero">
    <picture>
      <source type="image/webp" srcset={`${photos.hero.webpSmall} 800w, ${photos.hero.webp} 1280w`} sizes="100vw" />
      <img class="hero-photo" src={photos.hero.src} srcset={`${photos.hero.src} 1280w`} sizes="100vw" alt="Faisal Mosque (Faisal Masjid), Islamabad — main view of the white tent-like prayer hall and four minarets, Pakistan" width="1280" height="853" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero-shade"></div>
    <div class="container hero-content">
      <div class="hero-copy">
        <div class="hero-kicker"><span>National mosque of Pakistan</span><span>Foot of the Margalla Hills</span></div>
        <h1>Faisal Mosque<span class="h1-city">Islamabad, Pakistan</span></h1>
        <p class="hero-sub">A vast tent-like roof instead of a traditional dome, four slim minarets and white geometry set against the hills — an unusual chapter in Pakistan’s modern architectural identity.</p>
        <p class="hero-entity"><strong>Faisal Mosque</strong>, widely written as <strong>Faisal Masjid</strong> and formally <em>Shah Faisal Mosque</em>, is the national mosque of Islamabad, Islamabad Capital Territory, Pakistan, and an active place of worship.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#visit">Plan your visit <span aria-hidden="true">→</span></a>
          <a class="button button-ghost" href="#history">Read the history</a>
        </div>
      </div>
      <div class="hero-facts card">
        <div><small>Location</small><strong>Shah Faisal Ave, E-8</strong></div>
        <div><small>Entry</small><strong>Generally free</strong></div>
        <div><small>Suggested duration</small><strong>60–90 minutes</strong></div>
        <div><small>Visitor rating</small><strong>{siteMeta.rating} / 5</strong><span>{siteMeta.reviewCount.toLocaleString('en-US')} reviews (September 2026) · rating can change</span></div>
      </div>
      <a class="photo-credit" href={photos.hero.source} target="_blank" rel="noopener noreferrer">Photo: {photos.hero.credit}</a>
    </div>
  </section>

  <section class="entity-strip" aria-label="Location identity and geographic hierarchy">
    <div class="container entity-inner">
      <nav class="entity-crumbs" aria-label="Geographic hierarchy">
        <span>{siteMeta.countryLatin}</span><span aria-hidden="true">›</span>
        <span>{siteMeta.regionLatin}</span><span aria-hidden="true">›</span>
        <span>{siteMeta.cityLatin}</span><span aria-hidden="true">›</span>
        <strong>{siteMeta.englishName}</strong>
      </nav>
      <div class="entity-facts">
        <div><small>City / Territory</small><strong>{siteMeta.cityLatin}, {siteMeta.regionLatin}</strong></div>
        <div><small>Postal code</small><strong>{siteMeta.postalCode}</strong></div>
        <div><small>Phone</small><strong><a href={siteMeta.phoneHref}>{siteMeta.phone}</a></strong></div>
        <div><small>Plus code</small><strong>P2HP+XV Islamabad</strong></div>
      </div>
    </div>
  </section>

  <section class="quickbar" aria-label="Key practical information">
    <div class="container quick-grid">
      <div><span>◈</span><p><strong>Place of worship</strong><small>Prayer takes priority over sightseeing</small></p></div>
      <div><span>◇</span><p><strong>Dress</strong><small>Simple, modest, covering shoulders and legs</small></p></div>
      <div><span>⌁</span><p><strong>Shoes</strong><small>Removed before entering the prayer hall</small></p></div>
      <div><span>△</span><p><strong>Crowds</strong><small>Heavier on Friday, Ramadan and Eid</small></p></div>
    </div>
  </section>

  <section class="section intro">
    <div class="container intro-grid">
      <div>
        <SectionHeading
          eyebrow="Understand the place"
          title="About Faisal Mosque (Faisal Masjid), Islamabad"
          latin="Faisal Masjid · فیصل مسجد"
          lead="Not only a photographic landmark — it is a working mosque first."
        />
      </div>
      <div class="intro-copy">
        <p>Faisal Mosque stands at the northern edge of Islamabad, at the foot of the Margalla Hills. Its open white volume, tent-like central roof and four minarets form a clear landmark against the planned skyline of the capital. Seen as a visitor attraction, the essential point is that daily prayer, Friday congregations and religious gatherings take place here.</p>
        <p>This guide connects the historical and architectural material with the practical questions visitors actually ask: when to come, how to behave during prayer times, where public transport stops, what to expect from parking and restrooms, and what kind of city facilities sit nearby.</p>
      </div>
    </div>
  </section>

  <section id="history" class="section section-dark history">
    <div class="container">
      <SectionHeading
        eyebrow="Historical background"
        title="History & significance of Faisal Mosque, Islamabad"
        lead="The story is not limited to one person or one donation; it combines an international design competition, Pakistani institutional planning, Saudi financial support and several years of construction."
      />
      <div class="timeline">
        {history.map(([year, title, text]) => (
          <article><span>{year}</span><h3>{title}</h3><p>{text}</p></article>
        ))}
      </div>
      <div class="history-note">
        <strong>Editorial note</strong>
        <p>The popular short version describes the mosque purely as a “Saudi gift”, but Pakistani parliamentary and CDA material also documents Pakistani and CDA involvement in construction, funding and upkeep. A more balanced historical wording is used here.</p>
      </div>
      <div class="history-design">
        <h3>Architecture, symbolism and the design story</h3>
        <p>Vedat Dalokay chose the tent metaphor because the Bedouin tent is an old symbol of equality and simplicity; the four minarets recall the hilltop minarets of Turkish tradition and give the composition its vertical balance. The dome-less design was a deliberate departure from the traditional South Asian mosque.</p>
        <p>The main hall and courtyard together hold roughly three hundred thousand worshippers, placing it among the largest mosques in the world. Its cubic shell, white concrete and relationship with the Margalla Hills form a distinct, recognised identity within modern Islamic architecture.</p>
      </div>
    </div>
  </section>

  <section id="architecture" class="section architecture">
    <div class="container architecture-grid">
      <div class="arch-image">
        <img src={photos.courtyard.src} alt="Faisal Mosque, Islamabad — the broad courtyard, white stone and main prayer hall" width="1280" height="853" loading="lazy" />
        <a href={photos.courtyard.source} target="_blank" rel="noopener noreferrer">{photos.courtyard.credit}</a>
      </div>
      <div>
        <SectionHeading
          eyebrow="Architecture"
          title="A mosque without a dome: tent, hills and geometry"
          lead="Vedat Dalokay treated the building as a single sign of worship, landscape and modern engineering rather than a copy of a historic style."
        />
        <div class="point-list">
          {architecture.map(([title, text]) => (
            <article><h3>{title}</h3><p>{text}</p></article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="visit" class="section section-white visit">
    <div class="container">
      <SectionHeading
        eyebrow="Plan your visit"
        title="Location & how to visit Faisal Mosque in Islamabad"
        latin="Faisal Mosque visiting hours, entry fee and dress code"
        lead="The information below is for planning; because this is an active mosque, access to inner areas can change with prayer times, security and major gatherings."
      />
      <div class="visit-grid">
        {visitCards.map(([title, text]) => (
          <article class="card"><h3>{title}</h3><p>{text}</p></article>
        ))}
      </div>
    </div>
  </section>

  <WeatherSection lang="en" />

  <section id="transport" class="section transport">
    <div class="container">
      <SectionHeading
        eyebrow="Getting here"
        title="How to reach Faisal Mosque — airport, Metro bus, taxi and car"
        lead="Islamabad’s planned road grid makes access straightforward, but Friday, Ramadan and public holidays can add security and traffic delays."
      />
      <div class="transport-grid">
        {transport.map(([title, text]) => (
          <article><h3>{title}</h3><p>{text}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section id="map" class="section section-white map-section">
    <div class="container">
      <SectionHeading
        eyebrow="Location"
        title="At the foot of the Margalla Hills, Sector E-8, Islamabad"
        latin="Faisal Mosque, Islamabad — map & directions"
        lead="Check live traffic and any temporary security closure before you start the route."
      />
      <div class="map-grid">
        <div class="map-frame">
          <iframe
            src={siteMeta.mapsEmbedSrc}
            width="100%"
            height="420"
            style="border:0;"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            title="Faisal Mosque on Google Maps"></iframe>
        </div>
        <div class="map-details">
          <h3>Address &amp; contact</h3>
          <p>Shah Faisal Ave, Sector E-8, Islamabad 44000, Pakistan</p>
          <p>Plus code: P2HP+XV Islamabad, Pakistan</p>
          <p>Phone: <a href={siteMeta.phoneHref}>{siteMeta.phone}</a></p>
          <p>Coordinates: {siteMeta.latitude}, {siteMeta.longitude}</p>
          <p class="map-outbound">
            For official updates and regional tourism information, visit the
            <a href={govtTourismUrl} target="_blank" rel="noopener noreferrer">Pakistan Tourism Development Corporation portal</a>
            and the <a href="https://www.cda.gov.pk/" target="_blank" rel="noopener noreferrer">Capital Development Authority</a> website.
          </p>
          <p class="map-outbound">
            Open in <a href={siteMeta.mapsShareUrl} target="_blank" rel="noopener noreferrer">Google Maps</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="seasons" class="section seasons">
    <div class="container">
      <SectionHeading eyebrow={bi(t.qEyebrow)} title={bi(t.qTitle)} lead={bi(t.qLead)} />
      <div class="season-table">
        {quarterly.map((q) => (
          <article class="season-row">
            <div class="season-head">
              <h3>{bi(q.season)}</h3>
              <span class="season-months">{bi(q.months)}</span>
            </div>
            <div class="season-body">
              <p><strong>{bi(t.qClimate)}:</strong> {bi(q.climate)}</p>
              <p><strong>{bi(t.qAdvice)}:</strong> {bi(q.advice)}</p>
              <p class="season-best"><strong>{bi(t.qBest)}:</strong> {bi(q.bestFor)}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="climate" class="section section-dark climate">
    <div class="container">
      <SectionHeading eyebrow={bi(t.cEyebrow)} title={bi(t.cTitle)} lead={bi(t.cLead)} />
      <p class="climate-intro">{bi(climateNature.intro)}</p>
      <div class="climate-grid">
        {climateNature.points.map((p) => (
          <article class="climate-card">
            <span class="c-ic" aria-hidden="true">{p.icon}</span>
            <h3>{bi(p.title)}</h3>
            <p>{bi(p.body)}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="plans" class="section plans">
    <div class="container">
      <SectionHeading eyebrow={bi(t.pEyebrow)} title={bi(t.pTitle)} lead={bi(t.pLead)} />
      <div class="plan-grid">
        {groupPlans.map((pl) => (
          <article class="plan-card">
            <div class="plan-head">
              <span class="plan-ic" aria-hidden="true">{pl.icon}</span>
              <div>
                <h3>{bi(pl.title)}</h3>
                <span class="plan-dur">{bi(pl.duration)}</span>
              </div>
            </div>
            <p>{bi(pl.summary)}</p>
            <ul>{pl.tips.map((tip) => <li>{bi(tip)}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="routes" class="section section-white routes">
    <div class="container">
      <SectionHeading eyebrow={bi(t.rEyebrow)} title={bi(t.rTitle)} lead={bi(t.rLead)} />
      <div class="route-grid">
        {routes.map((r) => (
          <article class="route-card">
            <h3>{bi(r.title)}</h3>
            <p class="route-sum">{bi(r.summary)}</p>
            <ol class="route-steps">
              {r.steps.map((s) => (
                <li><span class="step-time">{bi(s.time)}</span><span>{bi(s.text)}</span></li>
              ))}
            </ol>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="services" class="section services">
    <div class="container">
      <SectionHeading eyebrow={bi(t.sEyebrow)} title={bi(t.sTitle)} lead={bi(t.sLead)} />
      <div class="service-grid">
        {visitorServices.map((s) => (
          <article class="service-card">
            <span class="s-ic" aria-hidden="true">{s.icon}</span>
            <h3>{bi(s.title)}</h3>
            <p>{bi(s.body)}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="responsibility" class="section section-dark responsibility">
    <div class="container">
      <SectionHeading eyebrow={bi(t.resEyebrow)} title={bi(t.resTitle)} lead={bi(t.resLead)} />
      <p class="resp-intro">{bi(responsibility.intro)}</p>
      <div class="resp-grid">
        {responsibility.points.map((p) => (
          <article class="resp-card">
            <span class="r-ic" aria-hidden="true">{p.icon}</span>
            <h3>{bi(p.title)}</h3>
            <p>{bi(p.body)}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <style>
    .seasons .season-table { display: grid; gap: 14px; margin-top: 34px; }
    .season-row { display: grid; grid-template-columns: .8fr 1.2fr; gap: 24px; padding: 24px; border: 1px solid var(--line); border-radius: 20px; background: #fffdf8; align-items: start; }
    .season-head h3 { margin: 0 0 4px; font-size: 1.2rem; }
    .season-months { color: #8f6d2f; font-size: .85rem; font-weight: 700; }
    .season-body p { margin: 0 0 8px; color: #3e5750; font-size: .92rem; line-height: 1.8; }
    .season-body strong { color: var(--ink); }
    .season-best { color: #566b63 !important; }
    .climate-intro { max-width: 880px; color: #c8d5cf; font-size: 1rem; margin: 0 0 30px; }
    .climate-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .climate-card { padding: 24px; border: 1px solid rgba(255,255,255,.12); border-radius: 20px; background: rgba(255,255,255,.04); }
    .climate-card .c-ic { font-size: 1.6rem; }
    .climate-card h3 { margin: 12px 0 8px; font-size: 1.1rem; color: #f4efe2; }
    .climate-card p { margin: 0; color: #b9c9c1; font-size: .9rem; line-height: 1.85; }
    .plan-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 34px; }
    .plan-card { padding: 26px; border: 1px solid var(--line); border-radius: 22px; background: #fffdf8; display: grid; align-content: start; }
    .plan-head { display: flex; gap: 14px; align-items: center; margin-bottom: 12px; }
    .plan-ic { font-size: 1.8rem; }
    .plan-head h3 { margin: 0; font-size: 1.12rem; }
    .plan-dur { color: #8f6d2f; font-size: .8rem; font-weight: 700; }
    .plan-card p { margin: 0 0 12px; color: #566b63; font-size: .9rem; }
    .plan-card ul { margin: 0; padding-inline-start: 1.1rem; color: #3e5750; font-size: .88rem; display: grid; gap: 7px; }
    .route-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-top: 34px; }
    .route-card { padding: 26px; border: 1px solid var(--line); border-radius: 22px; background: #fffdf8; }
    .route-card h3 { margin: 0 0 6px; font-size: 1.18rem; }
    .route-sum { color: #566b63; font-size: .9rem; margin: 0 0 16px; }
    .route-steps { margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; }
    .route-steps li { display: grid; grid-template-columns: 90px 1fr; gap: 12px; align-items: start; }
    .step-time { font-weight: 800; color: #8f6d2f; font-size: .85rem; }
