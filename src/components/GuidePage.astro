---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeatherSection from './WeatherSection.astro';
import {siteMeta} from '../data/site';
import data from '../data/guide.json';
const {lang='ur'}=Astro.props as {lang:'ur'|'en'};const en=lang==='en',t=data.locales[lang],path=en?'/en/':'/';
const schema=[{'@context':'https://schema.org','@type':'WebPage',url:'https://faisalmasjid.com'+path,name:t.title,inLanguage:lang,about:{'@type':'Mosque',name:'Faisal Masjid',alternateName:['Shah Faisal Mosque','Faisal Mosque','فیصل مسجد'],address:{'@type':'PostalAddress',streetAddress:'Shah Faisal Ave, E-8',addressLocality:'Islamabad',postalCode:'44000',addressCountry:'PK'},geo:{'@type':'GeoCoordinates',latitude:siteMeta.latitude,longitude:siteMeta.longitude}}},{'@context':'https://schema.org','@type':'FAQPage',mainEntity:t.faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}];
const hero=data.photos[0];
---
<BaseLayout lang={lang} alternatePath={en?'/':'/en/'} title={t.title} description={t.description} ogImage={hero.src} ogImageAlt={hero[lang]} jsonLd={schema}>
<section class="guide-hero"><div class="container"><p class="eyebrow">{en?'Independent visitor guide · Islamabad, Pakistan':'آزاد معلوماتی رہنما · اسلام آباد، پاکستان'}</p><h1>{en?'Faisal Mosque':'فیصل مسجد'} <span>{en?'Islamabad':'اسلام آباد'}</span></h1><p class="guide-lead">{t.intro}</p><div class="hero-actions"><a class="button button-primary" href="#history">{en?'Explore the history':'تاریخ پڑھیں'}</a><a class="button button-ghost" href="#visit">{en?'Plan a respectful visit':'دورے کی تیاری'}</a></div><figure><img src={hero.src} width={hero.width} height={hero.height} alt={hero[lang]} fetchpriority="high"/><figcaption>{hero[lang]} · {hero.author} · {hero.date} · <a href={hero.source}>Wikimedia Commons</a> · <a href={hero.licenceUrl}>{hero.licence}</a> · {en?'Resized / WebP. Historical view, not current access permission.':'حجم تبدیل / WebP۔ تاریخی منظر، موجودہ داخلے کی اجازت نہیں۔'}</figcaption></figure></div></section>
<div class="container guide-body">{t.sections.map(([id,title,text])=><section id={id}><h2>{title}</h2><p>{text}</p>{id==='history'&&<a href={data.sources[0].href}>{data.sources[0][lang]}</a>}{id==='architecture'&&<a href={data.sources[1].href}>{data.sources[1][lang]}</a>}{id==='transport'&&<a href={data.sources[2].href}>{data.sources[2][lang]}</a>}</section>)}
<section id="map"><h2>{en?'Address, map and dated listing':'پتہ، نقشہ اور تاریخ والی فہرست'}</h2><p dir="ltr">{siteMeta.address}</p><p>{en?'Google Maps place pin checked 20 October 2026:':'20 اکتوبر 2026 کو گوگل فہرست کا pin:'} <bdi>{siteMeta.latitude}, {siteMeta.longitude}</bdi>. {en?'The address and pin are orientation references, not a confirmed entrance.':'پتہ اور pin سمت کے لیے ہیں، تصدیق شدہ داخلی دروازہ نہیں۔'}</p><p>{en?'Google Maps snapshot, 20 October 2026: 4.7/5 from 74,440 reviews. This third-party rating may change and is not collected by this guide.':'گوگل نقشہ، 20 اکتوبر 2026: 4.7/5، 74,440 تبصرے۔ یہ تیسرے فریق کی بدلنے والی درجہ بندی ہے، اس رہنما کی جمع کردہ نہیں۔'}</p><p>{en?'Public listing phone (not called or confirmed):':'عوامی فہرست کا فون (کال یا تصدیق نہیں کی گئی):'} <a href={siteMeta.phoneHref} dir="ltr">{siteMeta.phone}</a></p><a class="button button-primary" href={siteMeta.mapsShareUrl} target="_blank" rel="noopener noreferrer">{en?'Open Google Maps':'گوگل نقشہ کھولیں'}</a><p>{en?'No map is loaded until you follow the external link. No operator website was listed in the reviewed Maps entry.':'بیرونی ربط کھولنے تک نقشہ لوڈ نہیں ہوتا۔ جائزہ شدہ گوگل فہرست میں آپریٹر ویب سائٹ درج نہیں تھی۔'}</p></section>
<section id="gallery"><h2>{en?'Dated photographs and credits':'تاریخ والی تصاویر اور نسبت'}</h2><p>{en?'These historical photographs do not establish current admission, photography permission or night access.':'ان تاریخی تصاویر سے موجودہ داخلہ، فوٹوگرافی کی اجازت یا رات کی رسائی ثابت نہیں ہوتی۔'}</p><div class="guide-gallery">{data.photos.slice(1).map(p=><figure><img src={p.src} width={p.width} height={p.height} alt={p[lang]} loading="lazy"/><figcaption>{p[lang]} · {p.author} · {p.date} · <a href={p.source}>Wikimedia Commons</a> · <a href={p.licenceUrl}>{p.licence}</a> · {en?'Resized / WebP':'حجم تبدیل / WebP'}</figcaption></figure>)}</div></section>
<section id="faq"><h2>{en?'Frequently asked questions':'عام سوالات'}</h2>{t.faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>
<section id="sources"><h2>{en?'Source scope and review':'ماخذ اور جائزے کی حدود'}</h2><p>{en?'Reviewed 20 October 2026. Institutional history and architecture are separate from current visitor permission. The available visitor-guide page did not establish current operational rules. Ask the administration directly; this site cannot grant access.':'جائزہ: 20 اکتوبر 2026۔ ادارتی تاریخ اور معماری موجودہ داخلے کی اجازت سے الگ ہیں۔ دستیاب وزیٹر گائیڈ سے موجودہ انتظامی قواعد واضح نہیں ہوئے۔ انتظامیہ سے براہِ راست پوچھیں؛ یہ سائٹ اجازت نہیں دے سکتی۔'}</p><ul id="references">{data.sources.map(s=><li><a href={s.href}>{s[lang]}</a></li>)}</ul></section>
<span id="climate"></span></div><WeatherSection lang={lang}/>
</BaseLayout>
