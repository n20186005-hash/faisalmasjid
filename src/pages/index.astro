---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SourcesSection from '../components/SourcesSection.astro';
import { faqUr } from '../data/faq';
import { buildAttractionSchema, buildBreadcrumbSchema, buildFaqSchema } from '../lib/schema';
import { govtTourismUrl, nearbyLandmarks, photos, siteMeta } from '../data/site';
import WeatherSection from '../components/WeatherSection.astro';
import {
  quarterly,
  climateNature,
  groupPlans,
  routes,
  visitorServices,
  responsibility,
  type Bi,
} from '../data/guide';

const en = false;
const bi = (b: Bi) => (en ? b.en : b.ur);
const t = {
  qEyebrow: { ur: 'ربع سالانہ حکمتِ عملی', en: 'Quarterly strategy' },
  qTitle: { ur: 'سال بھر میں بہترین وقت', en: 'The best time through the year' },
  qLead: { ur: 'اسلام آباد کے موسمی چکر کے مطابق فیصل مسجد دیکھنے کا منصوبہ بنائیں۔', en: 'Plan your Faisal Mosque visit around Islamabad’s seasonal cycle.' },
  qClimate: { ur: 'موسم', en: 'Climate' },
  qAdvice: { ur: 'مشورہ', en: 'Advice' },
  qBest: { ur: 'موزوں برائے', en: 'Best for' },
  cEyebrow: { ur: 'موسم، فضا اور قدرت', en: 'Climate, air & nature' },
  cTitle: { ur: 'موسم، فضائی معیار اور قدرتی ماحول کا تجزیہ', en: 'Climate, air quality & natural environment' },
  cLead: { ur: 'طویل المدت ریکارڈ کی بنیاد پر ایک متوازن تجزیہ۔', en: 'A balanced reading based on long-term records.' },
  pEyebrow: { ur: 'آپ کا سفری گروپ', en: 'Your travel group' },
  pTitle: { ur: 'سفری تشکیل کے مطابق تجاویز', en: 'Tips by travel composition' },
  pLead: { ur: 'اپنی سفری ترکیب اور رفتار کے مطابق راستہ چنیں۔', en: 'Choose a route by your group and pace.' },
  rEyebrow: { ur: 'تجویز کردہ راستے', en: 'Suggested routes' },
  rTitle: { ur: 'عمومی راستے: نصفِ دن اور پورا دن', en: 'General routes: half-day & full-day' },
  rLead: { ur: 'وقت کے مطابق دو متبادل راستے۔', en: 'Two alternatives by available time.' },
  sEyebrow: { ur: 'زائرین کی سہولیات', en: 'Visitor services' },
  sTitle: { ur: 'آس پاس کی سہولیات (قسم کے لحاظ سے)', en: 'Facilities nearby (by type)' },
  sLead: { ur: 'مخصوص کاروبار کی سفارش نہیں، صرف اقسام کی رہنمائی۔', en: 'No specific business recommended — only guidance by type.' },
  resEyebrow: { ur: 'سائنسی پہلو اور ذمہ داری', en: 'Science & responsibility' },
  resTitle: { ur: 'زائرین کی ذمہ داری اور مقام کی حفاظت', en: 'Visitor responsibility & site care' },
  resLead: { ur: 'ایک پر امن مقام کو برقرار رکھنے میں آپ کا کردار۔', en: 'Your role in keeping a peaceful site intact.' },
};

const pageUrl = Astro.site ? new URL('/', Astro.site).href : undefined;
const attractionJsonLd = buildAttractionSchema(pageUrl);
const breadcrumbJsonLd = buildBreadcrumbSchema(pageUrl, [
  { name: siteMeta.countryLatin, url: pageUrl },
  { name: siteMeta.regionLatin },
  { name: siteMeta.cityLatin },
  { name: `${siteMeta.englishName} (${siteMeta.latinName})` },
]);
const faqItems = faqUr;
const faqJsonLd = buildFaqSchema(faqItems);

const nearby = [
  ['مارگلہ ہلز نیشنل پارک', 'مسجد کے پس منظر میں واقع پہاڑی سلسلہ؛ پیدل راستوں اور قدرتی مناظر کے لیے اسی دن کا موزوں امتزاج۔'],
  ['دامنِ کوہ', 'اسلام آباد کے شہری منظر کو بلندی سے دیکھنے کے لیے معروف مقام؛ موسم اور ٹریفک کے مطابق اضافی وقت رکھیں۔'],
  ['سیدپور گاؤں', 'مارگلہ کے دامن میں تاریخی بستی اور ثقافتی ماحول؛ مسجد کے دورے کے ساتھ شہر کی پرانی آبادی کا مختلف پہلو دکھاتی ہے۔'],
  ['پاکستان مونومنٹ و میوزیم', 'قومی تاریخ اور علامتی فنِ تعمیر کو سمجھنے کے لیے موزوں؛ فیصل مسجد کی جدید قومی شناخت کے ساتھ تقابلی مطالعہ ممکن ہے۔'],
  ['لوک ورثہ', 'پاکستان کے علاقائی ثقافتی ورثے، دستکاری اور لوک روایات پر توجہ دینے والا ثقافتی مقام۔'],
  ['راول جھیل کے اطراف', 'شہر کے جنوب مشرق میں کھلا منظر اور تفریحی ماحول؛ وقت کی کمی ہو تو اسے الگ نصف روزہ پروگرام سمجھیں۔'],
];
---
export const prerender = false;

<BaseLayout
  lang="ur"
  alternatePath="/en/"
  title="فیصل مسجد اسلام آباد — تاریخ، اوقات، داخلہ اور سیاحتی رہنما | Faisal Masjid Islamabad"
  description={`فیصل مسجد اسلام آباد (Faisal Masjid / Shah Faisal Mosque) کا مکمل اردو رہنما: داخلہ عام طور پر مفت، نماز کے اوقات اور دورے کا بہترین وقت، لباس اور آداب، پبلک ٹرانسپورٹ (FR-03A) اور پارکنگ، مارگلہ ہلز کے دامن مقام و نقشہ، تاریخ اور فنِ تعمیر۔`}
  ogImage={photos.hero.src}
  ogImageAlt="فیصل مسجد (Faisal Masjid)، اسلام آباد — مارگلہ پہاڑیوں کے سامنے سفید خیمہ نما مرکزی ہال اور چار مینار"
  jsonLd={[attractionJsonLd, faqJsonLd, breadcrumbJsonLd].filter(Boolean)}
>
  <section class="hero">
    <picture>
      <source type="image/webp" srcset={`${photos.hero.webpSmall} 800w, ${photos.hero.webp} 1280w`} sizes="100vw" />
      <img class="hero-photo" src={photos.hero.src} srcset={`${photos.hero.src} 1280w`} sizes="100vw" alt={photos.hero.alt} width="1280" height="853" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero-shade"></div>
    <div class="hero-lines" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <div class="container hero-content">
      <div class="hero-copy">
        <div class="hero-kicker"><span>اسلام آباد کی قومی مسجد</span><span>مارگلہ پہاڑیوں کا دامن</span></div>
        <h1>فیصل مسجد<span class="h1-city">اسلام آباد، پاکستان</span></h1>
        <p class="hero-sub">روایتی گنبد کے بجائے ایک عظیم خیمہ نما چھت، چار باریک مینار اور پہاڑوں کے سامنے سفید جیومیٹری — پاکستان کی جدید قومی شناخت کا ایک غیر معمولی تعمیراتی باب۔</p>
        <p class="hero-entity"><strong>فیصل مسجد</strong> یعنی <span lang="en" dir="ltr">Faisal Masjid (Shah Faisal Mosque)</span> اسلام آباد، اسلام آباد کیپیٹل ٹیریٹری، پاکستان کی قومی مسجد اور ایک فعال عبادت گاہ ہے۔</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#visit">دورہ ترتیب دیں <span aria-hidden="true">←</span></a>
          <a class="button button-ghost" href="#history">تاریخ پڑھیں</a>
        </div>
      </div>
      <div class="hero-facts card">
        <div><small>مقام</small><strong>شاہ فیصل ایونیو، E-8</strong></div>
        <div><small>داخلہ</small><strong>عمومی طور پر مفت</strong></div>
        <div><small>موزوں مدت</small><strong>60–90 منٹ</strong></div>
        <div><small>عوامی درجہ بندی</small><strong>{siteMeta.rating} / 5</strong><span>{siteMeta.reviewCount.toLocaleString('en-US')} تبصرے (ستمبر 2026) · درجہ بندی بدل سکتی ہے</span></div>
      </div>
      <a class="photo-credit" href={photos.hero.source} target="_blank" rel="noopener noreferrer">تصویر: {photos.hero.credit}</a>
    </div>
  </section>

  <section class="entity-strip" aria-label="مقام کی شناخت اور جغرافیائی تدرج">
    <div class="container entity-inner">
      <nav class="entity-crumbs" aria-label="جغرافیائی تدرج">
        <span>{siteMeta.country}</span><span aria-hidden="true">›</span>
        <span>{siteMeta.region}</span><span aria-hidden="true">›</span>
        <span>{siteMeta.city}</span><span aria-hidden="true">›</span>
        <strong>{siteMeta.attractionName}</strong>
      </nav>
      <div class="entity-facts">
        <div><small>شہر / وفاقی علاقہ</small><strong>{siteMeta.city}، {siteMeta.region}</strong></div>
        <div><small>پوسٹل کوڈ</small><strong dir="ltr">{siteMeta.postalCode}</strong></div>
        <div><small>رابطہ نمبر</small><strong><a href={siteMeta.phoneHref} dir="ltr">{siteMeta.phone}</a></strong></div>
        <div><small>پلس کوڈ</small><strong dir="ltr">P2HP+XV</strong></div>
      </div>
    </div>
  </section>

  <section class="quickbar" aria-label="اہم عملی معلومات">
    <div class="container quick-grid">
      <div><span>◈</span><p><strong>مذہبی مقام</strong><small>نماز اور عبادت کو سیاحت پر ترجیح حاصل ہے</small></p></div>
      <div><span>◇</span><p><strong>لباس</strong><small>سادہ، باوقار اور جسم ڈھانپنے والا</small></p></div>
      <div><span>⌁</span><p><strong>جوتے</strong><small>عبادت گاہ میں داخلے سے پہلے اتاریں</small></p></div>
      <div><span>△</span><p><strong>ہجوم</strong><small>جمعہ، رمضان اور عید پر زیادہ</small></p></div>
    </div>
  </section>

  <section class="section intro mosque-motif">
    <div class="container intro-grid">
      <div>
        <SectionHeading
          eyebrow="جگہ کو سمجھیں"
          title="فیصل مسجد کے بارے میں — اسلام آباد کی فعال قومی مسجد"
          latin="About Faisal Masjid (Shah Faisal Mosque), Islamabad"
          lead="یہ صرف ایک تصویری نشان نہیں، ایک فعال عبادت گاہ بھی ہے۔"
        />
      </div>
      <div class="intro-copy">
        <p>فیصل مسجد اسلام آباد کے شمالی کنارے پر مارگلہ پہاڑیوں کے دامن میں واقع ہے۔ اس کا کھلا سفید حجم، خیمہ نما مرکزی چھت اور چار مینار شہر کے منصوبہ بند افق کے مقابل ایک واضح علامت بناتے ہیں۔ عمارت کو سیاحتی مقام کے طور پر دیکھتے وقت یہ بنیادی بات اہم ہے کہ یہاں روزمرہ عبادت، جمعہ اور مذہبی اجتماعات ہوتے ہیں۔</p>
        <p>اس رہنما میں تاریخی اور تعمیراتی معلومات کو زائرین کے عملی سوالات سے جوڑا گیا ہے: کب جانا بہتر ہے، نماز کے اوقات میں کیسے برتاؤ کرنا چاہیے، پبلک ٹرانسپورٹ کہاں سے ملتی ہے، پارکنگ اور بیت الخلا کے بارے میں کیا توقع رکھی جائے اور قریبی شہری سہولیات کس نوعیت کی ہیں۔</p>
      </div>
    </div>
  </section>

  <section id="history" class="section section-dark history">
    <div class="container">
      <SectionHeading eyebrow="تاریخی پس منظر" title="فیصل مسجد کی تاریخ اور اہمیت — ایک بین الاقوامی مقابلے سے قومی مسجد تک" latin="History & significance of Faisal Masjid, Islamabad" lead="فیصل مسجد کی کہانی ایک فرد یا ایک عطیے تک محدود نہیں؛ یہ بین الاقوامی ڈیزائن مقابلہ، پاکستانی ادارہ جاتی منصوبہ بندی، سعودی مالی تعاون اور کئی سال کی تعمیر کا مجموعہ ہے۔" />
      <div class="timeline">
        <article><span>1969</span><h3>بین الاقوامی ڈیزائن مقابلہ</h3><p>کیپٹل ڈویلپمنٹ اتھارٹی اور پاکستانی تعمیراتی حلقوں کے زیرِ اہتمام مقابلے میں 17 ممالک سے 43 تجاویز آئیں۔ ترک معمار ویدات دالوکے کا تصور منتخب ہوا۔</p></article>
        <article><span>1970ء کی دہائی</span><h3>روایتی گنبد سے مختلف تصور</h3><p>منتخب منصوبہ روایتی جنوبی ایشیائی مسجد کی نقل کے بجائے بڑے بدوی خیمے جیسی تکونی کنکریٹ خول پر قائم تھا، جس نے جدید اسلام آباد کے لیے نئی بصری زبان تجویز کی۔</p></article>
        <article><span>1976</span><h3>تعمیر کا آغاز</h3><p>تعمیراتی مرحلہ 1970 کی دہائی کے وسط میں شروع ہوا۔ سعودی عرب کے شاہ فیصل کے نام سے مسجد منسوب ہوئی؛ سعودی تعاون اہم تھا، جبکہ پاکستانی سرکاری اور سی ڈی اے ریکارڈ تعمیر و دیکھ بھال میں مقامی ادارہ جاتی کردار بھی واضح کرتے ہیں۔</p></article>
        <article><span>1986</span><h3>عمارت کی تکمیل</h3><p>تقریباً ایک دہائی کی تعمیر کے بعد مرکزی کمپلیکس مکمل ہوا۔ بعد کے برسوں میں یہ قومی مسجد، فعال عبادت گاہ اور اسلام آباد کی سب سے پہچانی جانے والی جدید عمارتوں میں شمار ہونے لگی۔</p></article>
      </div>
      <div class="history-note"><strong>ادارتی نوٹ</strong><p>مشہور مختصر روایت اسے صرف “سعودی تحفہ” کہتی ہے، لیکن پاکستانی پارلیمانی اور سی ڈی اے مواد تعمیر، مالیات اور دیکھ بھال میں پاکستان اور سی ڈی اے کی شمولیت بھی بیان کرتا ہے۔ اسی لیے یہاں زیادہ متوازن تاریخی زبان استعمال کی گئی ہے۔</p></div>
      <div class="history-design">
        <h3>معماری علامتیات اور ڈیزائن کی کہانی</h3>
        <p>ویدات دالوکے نے خیمے کے استعارے کو اس لیے چنا کہ بدوی خیمہ مساوات اور سادگی کی ایک قدیم علامت ہے؛ چاروں مینار ترکی روایت کے پہاڑی میناروں کی یاد دلاتے ہیں اور عمودی توازن پیدا کرتے ہیں۔ بغیر گنبد کے یہ ڈیزائن روایتی جنوبی ایشیائی مسجد سے جان بوجھ کر الگ کھڑا کیا گیا۔</p>
        <p>مرکزی ہال اور صحن مل کر تقریباً تین لاکھ نمازیوں کی گنجائش رکھتے ہیں، جس سے یہ دنیا کی سب سے بڑی مسجدوں میں شمار ہوتی ہے۔ اس کا مربع نما ڈھانچہ، سفید کنکریٹ اور مارگلہ پہاڑیوں کے ساتھ تعلق جدید اسلامی تعمیرات کی ایک الگ اور پہچانی جانے والی شناخت ہے۔</p>
      </div>
    </div>
  </section>

  <section id="architecture" class="section architecture">
    <div class="container architecture-grid">
      <div class="arch-image">
        <img src={photos.courtyard.src} alt={photos.courtyard.alt} width="1280" height="853" loading="lazy" />
        <a href={photos.courtyard.source} target="_blank" rel="noopener noreferrer">{photos.courtyard.credit}</a>
      </div>
      <div>
        <SectionHeading eyebrow="فنِ تعمیر" title="گنبد کے بغیر مسجد: خیمہ، پہاڑ اور جیومیٹری" lead="ویدات دالوکے نے عمارت کو تاریخی طرز کی نقل بنانے کے بجائے عبادت، منظرنامے اور جدید انجینئرنگ کے ایک جامع نشان کے طور پر سوچا۔" />
        <div class="arch-points">
          <article><b>01</b><div><h3>خیمہ نما مرکزی خول</h3><p>آٹھ رخا کنکریٹ ساخت اپنی تیز مثلثی سطحوں سے بدوی خیمے کا تجریدی تاثر دیتا ہے۔ اسی وجہ سے مسجد دور سے بھی روایتی گنبد والی عمارتوں سے فوراً مختلف نظر آتی ہے۔</p></div></article>
          <article><b>02</b><div><h3>چار باریک مینار</h3><p>چاروں کونوں پر اٹھتے ہوئے بلند مینار مرکزی چھت کے کم اور پھیلے ہوئے حجم کے مقابل عمودی توازن پیدا کرتے ہیں، اور شہر کے دور دراز حصوں سے خاکہ واضح کرتے ہیں۔</p></div></article>
          <article><b>03</b><div><h3>مارگلہ ہلز بطور پس منظر</h3><p>عمارت کا اثر صرف تعمیراتی مادّے سے نہیں بنتا؛ شمال میں پہاڑ خود مجموعی منظر کا حصہ ہیں۔ صبح، دھند، مون سون اور شام میں سفید سطحوں اور سبز/نیلے پس منظر کا رشتہ بدلتا رہتا ہے۔</p></div></article>
          <article><b>04</b><div><h3>اندرونی خطاطی اور روشنی</h3><p>مرکزی ہال میں بڑے پیمانے کی خطاطی، هندسی سطحیں اور کنٹرول شدہ روشنی بیرونی سادگی سے مختلف روحانی ماحول پیدا کرتی ہیں۔ اندرونی رسائی ہمیشہ عبادت اور انتظامی ہدایات کے تابع ہے۔</p></div></article>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-white etiquette">
    <div class="container">
      <SectionHeading eyebrow="زائرین کے آداب" title="مسجد کو پہلے عبادت گاہ سمجھیں" lead="چند سادہ اصول آپ کے دورے کو احترام، سکون اور مقامی روایت کے مطابق رکھتے ہیں۔" />
      <div class="etiquette-grid">
        <article><span>01</span><h3>لباس باوقار رکھیں</h3><p>کندھے، سینہ اور ٹانگیں مناسب طور پر ڈھانپیں۔ خواتین کے لیے سر ڈھانپنے کے لیے اسکارف ساتھ رکھنا عملی انتخاب ہے۔</p></article>
        <article><span>02</span><h3>نماز میں خاموش رہیں</h3><p>اذان اور جماعت کے وقت گفتگو، سیاحتی انداز میں تصویر بنوانا اور تیز نقل و حرکت کم کریں؛ عبادت کرنے والوں کے سامنے سے نہ گزریں۔</p></article>
        <article><span>03</span><h3>جوتوں کی تیاری</h3><p>عبادت گاہ میں داخلے سے پہلے جوتے اتارنے ہوتے ہیں۔ جوتوں کا ہلکا تھیلا ساتھ رکھنے سے جوتے محفوظ اور راستہ منظم رہتا ہے۔</p></article>
        <article><span>04</span><h3>تصویر میں پرائیویسی</h3><p>لوگوں کے چہروں، خواتین کے حصوں یا نماز کے قریبی مناظر کی تصویر اجازت کے بغیر نہ بنائیں۔ سکیورٹی کے اشاروں پر عمل کریں۔</p></article>
      </div>
    </div>
  </section>

  <section id="visit" class="section visit">
    <div class="container">
      <SectionHeading eyebrow="دورہ ترتیب دیں" title="مقام اور دورہ: اسلام آباد میں فیصل مسجد تک کیسے پہنچیں اور کتنا وقت دیں" latin="Location & how to visit Faisal Masjid in Islamabad" lead="نیچے دی گئی معلومات منصوبہ بندی کے لیے ہیں؛ فعال مسجد ہونے کی وجہ سے نماز، سکیورٹی اور بڑے اجتماعات کے دن اندرونی رسائی بدل سکتی ہے۔" />
      <div class="visit-cards">
        <article class="visit-card featured"><small>داخلہ / فیس</small><strong>مفت</strong><p>عمومی سیاحتی داخلے کے لیے ٹکٹ کی ضرورت نہیں۔ عطیہ یا مذہبی خیرات کو داخلہ فیس نہ سمجھیں۔</p></article>
        <article class="visit-card"><small>عوامی فہرست میں درج اوقات</small><strong>24 گھنٹے</strong><p>مگر اس کا مطلب ہر اندرونی حصہ ہر وقت سیاحوں کے لیے کھلا ہونا نہیں۔ نماز اور سکیورٹی ہدایات مقدم ہیں۔</p></article>
        <article class="visit-card"><small>تجویز کردہ قیام</small><strong>60–90 منٹ</strong><p>صحن، فنِ تعمیر، دستیاب اندرونی حصہ اور پرسکون مشاہدہ شامل ہو۔ فوٹوگرافی یا ہجوم ہو تو زیادہ وقت رکھیں۔</p></article>
        <article class="visit-card"><small>نسبتاً بہتر وقت</small><strong>صبح یا شام سے پہلے</strong><p>عام دفتری دنوں میں نسبتاً کم ہجوم مل سکتا ہے۔ غروب کے قریب روشنی خوبصورت ہے، مگر نماز کے وقت رفتار اور شور کم کریں۔</p></article>
      </div>
      <div class="season-grid">
        <div><h3>گرمی</h3><p>دوپہر کی دھوپ صحن میں سخت محسوس ہو سکتی ہے۔ ہلکا لباس، پانی اور دھوپ سے بچاؤ رکھیں، مگر لباس مسجد کے آداب کے مطابق ہو۔</p></div>
        <div><h3>مون سون</h3><p>بادل اور سبز مارگلہ خوبصورت پس منظر بناتے ہیں، لیکن بارش اور پھسلن کے لیے جوتے اور سفر کا اضافی وقت رکھیں۔</p></div>
        <div><h3>سردی</h3><p>صبح اور شام ٹھنڈی ہو سکتی ہے؛ صاف موسم میں پہاڑی منظر واضح رہتا ہے۔ تہہ دار لباس عملی انتخاب ہے۔</p></div>
      </div>
    </div>
  </section>

