---
import { sourceLinks, sourceLinksEn } from '../data/site';
const { lang = 'ur' } = Astro.props;
const en = lang === 'en';
const links = en ? sourceLinksEn : sourceLinks;
const copy = {
  disclaimer: en
    ? 'This website is an independent visitor information project and is not affiliated with any government body, mosque administration or official organisation.'
    : 'یہ ویب سائٹ ایک آزاد معلوماتی رہنما منصوبہ ہے اور کسی سرکاری ادارے، مسجد انتظامیہ یا سرکاری تنظیم سے منسلک نہیں۔',
  principlesTitle: en ? 'Editorial principles' : 'معلوماتی اصول',
  principles: en ? 'Sources are linked with their scope and review date. Current access must be checked with the administration.' : 'ماخذ کے روابط، دائرہ اور جائزے کی تاریخ درج ہیں۔ موجودہ داخلہ انتظامیہ سے معلوم کریں۔',
  pagesTitle: en ? 'Key pages' : 'اہم صفحات',
  sourcesLabel: en ? 'Public sources' : 'عوامی ماخذ',
  credits: en
    ? 'Image credits: all photographs shown remain the property of their original photographers and are used under their respective free licences.'
    : 'تصویری حقوق: اس ویب سائٹ پر دکھائی جانے والی تمام تصاویر کے حقوق ان کے اصل فوٹوگرافرز کے پاس ہیں؛ استعمال متعلقہ آزاد اجازت ناموں کے تحت ہے۔',
  copyright: en ? '© 2026 Faisal Mosque visitor guide. Image licences remain as credited.' : '© 2026 فیصل مسجد رہنما۔ تصاویر کے اجازت نامے اپنی درج نسبت کے مطابق برقرار ہیں۔',
};
const pages = en
  ? [
      ['Privacy policy (Urdu)', '/privacy/'],
      ['Terms of use (Urdu)', '/terms/'],
      ['Cookie settings (Urdu)', '/cookies/'],
      ['Research method', '/en/#sources'],
      ['Official sources', '/en/#references'],
    ]
  : [
      ['رازداری کی پالیسی', '/privacy/'],
      ['استعمال کی شرائط', '/terms/'],
      ['کوکی ترتیبات', '/cookies/'],
      ['تحقیقی طریقہ', '/#sources'],
      ['سرکاری ماخذ', '/#references'],
    ];
---
<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src="/logo.svg" alt={en ? 'Faisal Mosque visitor guide' : 'فیصل مسجد رہنما'} width="260" height="75" />
      <p>{copy.disclaimer}</p>
    </div>
    <div>
      <h2>{copy.principlesTitle}</h2>
      <p>{copy.principles}</p>
    </div>
    <div>
      <h2>{copy.pagesTitle}</h2>
      <ul>
        {pages.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
      </ul>
      <p class="lang-row">
        <a href={en ? '/' : '/en/'} hreflang={en ? 'ur-PK' : 'en-US'} rel="alternate">{en ? 'اردو میں پڑھیں' : 'Read in English'}</a>
      </p>
    </div>
  </div>
  <div class="container source-row" aria-label={copy.sourcesLabel}>
    {links.map((source) => <a href={source.href} target="_blank" rel="noopener noreferrer">{source.label}</a>)}
  </div>
  <div class="container footer-bottom">
    <p>{copy.credits}</p>
    <p>{copy.copyright}</p>
  </div>
</footer>

<style>
.footer { background:#091b17; color:#dce7e1; padding:64px 0 24px; }
.footer-grid { display:grid; grid-template-columns:1.25fr 1.2fr .75fr; gap:48px; }
.footer-brand img { width:260px; height:auto; border-radius:14px; }
h2 { color:#f4efe2; font-size:1.05rem; margin:0 0 12px; }
p { color:#afc0b8; margin:0; font-size:.9rem; line-height:1.9; }
ul { list-style:none; padding:0; margin:0; display:grid; gap:8px; }
li a { color:#dce7e1; text-decoration:none; font-size:.9rem; }
li a:hover { color:#d8bc7b; }
.source-row { border-top:1px solid rgba(255,255,255,.1); margin-top:38px; padding-top:24px; display:flex; flex-wrap:wrap; gap:10px 24px; }
.source-row a { color:#a9bbb2; font-size:.8rem; text-underline-offset:4px; }
.footer-bottom { border-top:1px solid rgba(255,255,255,.1); margin-top:24px; padding-top:20px; display:flex; justify-content:space-between; gap:24px; }
.footer-bottom p { font-size:.78rem; }
.lang-row { margin: 14px 0 0 !important; }
.lang-row a { color:#d8bc7b; text-decoration:none; font-size:.85rem; font-weight:700; }
@media(max-width:850px){ .footer-grid{grid-template-columns:1fr;gap:28px}.footer-bottom{flex-direction:column}.source-row{display:grid} }
</style>
