---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME } from '../data/site';
import '../styles/global.css';

interface Props {
  noindex?: boolean;
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  jsonLd?: Record<string, unknown>[];
  compactHeader?: boolean;
  /** صفحے کی زبان — طے شدہ اردو */
  lang?: 'ur' | 'en';
  /** دوسری زبان میں اسی صفحے کا راستہ (مثلاً /en/ یا /) — hreflang کے لیے */
  alternatePath?: string;
}

const {
  noindex = false,
  title,
  description,
  ogImage = "/images/photo-1.webp",
  ogImageAlt,
  jsonLd = [],
  compactHeader = false,
  lang = 'ur',
  alternatePath,
} = Astro.props;
const isEnglish = lang === 'en';
const dir = isEnglish ? 'ltr' : 'rtl';
const locale = isEnglish ? 'en_US' : 'ur_PK';
const altLocale = isEnglish ? 'ur_PK' : 'en_US';
const canonicalUrl = Astro.site ? new URL(noindex ? "/404/" : Astro.url.pathname, Astro.site).href : undefined;
const alternateUrl = Astro.site && alternatePath ? new URL(alternatePath, Astro.site).href : undefined;
const hreflangLinks = canonicalUrl && alternateUrl
  ? [
      { hreflang: isEnglish ? 'en-US' : 'ur-PK', href: canonicalUrl },
      { hreflang: isEnglish ? 'ur-PK' : 'en-US', href: alternateUrl },
      { hreflang: 'x-default', href: isEnglish ? alternateUrl : canonicalUrl },
    ]
  : [];
const appTitle = isEnglish ? 'Faisal Mosque' : 'فیصل مسجد';
const ogImageUrl = ogImage?.startsWith('http') ? ogImage : (ogImage && Astro.site ? new URL(ogImage, Astro.site).href : undefined);
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#0b211c" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large"} />
    <meta name="author" content={SITE_NAME} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={appTitle} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content={appTitle} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {hreflangLinks.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale} />
    <meta property="og:locale:alternate" content={altLocale} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:alt" content={ogImageAlt ?? 'فیصل مسجد، اسلام آباد'} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image:alt" content={ogImageAlt ?? 'فیصل مسجد، اسلام آباد'} />}
    <title>{title}</title>
    {jsonLd.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} />)}
    <script is:inline defer src="/js/consent.js"></script>
    <script is:inline defer src="/js/retire-sw.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{isEnglish ? 'Skip to main content' : 'مرکزی مواد پر جائیں'}</a>
    <Header compact={compactHeader} lang={lang} />
    <main id="main-content"><slot /></main>
    <Footer lang={lang} />
    <aside id="cookie-banner" class="consent-banner hidden" aria-label={isEnglish?'Analytics choice':'تجزیاتی انتخاب'}><p>{isEnglish?'Optional analytics stays off until you allow it.':'اختیاری تجزیات اجازت دینے تک بند رہتے ہیں۔'}</p><button data-cookie-reject>{isEnglish?'Reject analytics':'تجزیات مسترد کریں'}</button><button data-cookie-accept>{isEnglish?'Allow analytics':'تجزیات کی اجازت'}</button><a href="/cookies/">{isEnglish?'Settings (Urdu)':'ترتیبات'}</a><p data-consent-status aria-live="polite"></p></aside>

  </body>
</html>
